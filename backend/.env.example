# Google Gemini LLM API Key (Required for multi-agent reasoning)
GEMINI_API_KEY=your_gemini_api_key_here

# Serper Search API Key (Required for live web search tools)
SERPER_API_KEY=your_serper_api_key_here

# Database URL
# For production (PostgreSQL e.g. Neon, Supabase, Vercel Postgres):
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# If left unset or unreachable, WaypointZero automatically falls back to local SQLite (waypointzero.db)
DATABASE_URL=sqlite:///./waypointzero.db

# Server Host & Port
HOST=0.0.0.0
PORT=8000
